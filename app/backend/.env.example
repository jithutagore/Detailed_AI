# Copy to .env and adjust. .env is gitignored; this file documents what's available.

ENVIRONMENT=development
DEBUG=true

# Absolute or relative-to-cwd path to the sqlite file. Defaults to <repo>/db/syllabus.db.
# DATABASE_PATH=D:/ai_agent/db/syllabus.db

# Required in any shared/production environment — without it, a random key is
# generated per process and every issued token stops working on restart.
SECRET_KEY=change-me-to-a-long-random-value
ACCESS_TOKEN_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO
LOG_JSON=false

# AI notes generation (OpenRouter). No default — leave unset to disable the feature;
# the generate endpoint returns a clear error instead of failing obscurely.
# Get a key at https://openrouter.ai/keys — never commit the real value.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
